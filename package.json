{
  "name": "folio-html-reader",
  "productName": "页间",
  "version": "0.30.3",
  "description": "本地 HTML / PDF 阅读、批注与项目管理",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "XiangXiaoYuan5254",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/build-speech.mjs && node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "npm run build && node tests/layout.e2e.mjs && node tests/e2e.mjs && node tests/annotations.e2e.mjs && node tests/reading-interactions.e2e.mjs && node tests/zoom.e2e.mjs && node tests/pdf.e2e.mjs && node tests/tabs.e2e.mjs && node tests/text-width.e2e.mjs && node tests/source.e2e.mjs && node tests/open-file.e2e.mjs && node tests/ai.e2e.mjs && node tests/settings.e2e.mjs && node tests/plugins.e2e.mjs && node tests/plugin-dev.e2e.mjs",
    "test:annotations": "npm run build && node tests/annotations.e2e.mjs",
    "pack": "npm run build && node scripts/build-speech.mjs && electron-builder --mac dir",
    "format": "prettier --write src electron scripts tests vite.config.ts",
    "dist:mac": "npm run build && node scripts/build-speech.mjs && APPLE_KEYCHAIN_PROFILE=helloxxy-notary electron-builder --mac dmg zip --arm64 --publish never && spctl -a -vv -t exec release/mac-arm64/页间.app 2>&1 | grep 'source=Notarized Developer ID' && xcrun stapler validate release/mac-arm64/页间.app && node scripts/checksums.mjs mac",
    "dist:win": "npm run build && node scripts/win-native.mjs && electron-builder --win nsis --x64 --publish never && node scripts/checksums.mjs win",
    "test:reading": "npm run build && node tests/reading-interactions.e2e.mjs",
    "test:zoom": "npm run build && node tests/zoom.e2e.mjs",
    "test:pdf": "npm run build && node tests/pdf.e2e.mjs",
    "test:tabs": "npm run build && node tests/tabs.e2e.mjs",
    "test:text-width": "npm run build && node tests/text-width.e2e.mjs",
    "test:source": "npm run build && node tests/source.e2e.mjs && node tests/open-file.e2e.mjs",
    "test:open-file": "npm run build && node tests/open-file.e2e.mjs",
    "test:ai": "npm run build && node tests/ai.e2e.mjs",
    "test:plugins": "npm run build && node tests/plugins.e2e.mjs",
    "test:plugin-dev": "npm run build && node tests/plugin-dev.e2e.mjs",
    "test:settings": "npm run build && node tests/settings.e2e.mjs",
    "test:model-picks": "npm run build && node tests/model-picks.e2e.mjs",
    "test:ui-type": "npm run build && node tests/ui-type.e2e.mjs",
    "test:new-file": "npm run build && node tests/new-file.e2e.mjs",
    "test:companion-prompt": "npm run build && node tests/companion-prompt.e2e.mjs",
    "test:storage": "npm run build && node tests/storage.e2e.mjs",
    "test:ai-live": "npm run build && node tests/ai-live.mjs",
    "test:board-attachments": "npm run build && node tests/board-attachments.e2e.mjs",
    "test:windows": "node tests/windows.e2e.mjs",
    "test:voice": "npm run build && node tests/voice.e2e.mjs",
    "test:voice-recovery": "npm run build && node tests/voice-recovery.e2e.mjs",
    "test:update": "npm run build && node tests/update.e2e.mjs",
    "website:shots": "npm run build && node scripts/website-shots/shoot.mjs",
    "website:downloads": "node scripts/website-downloads.mjs",
    "website:plugins": "node scripts/website-plugins.mjs",
    "promo:capture": "npm run build && node scripts/promo-video/capture.mjs",
    "promo:render": "node scripts/promo-video/render.mjs",
    "test:layout": "npm run build && node tests/layout.e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "codemirror": "^6.0.2",
    "electron-updater": "6.8.9",
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "mpg123-decoder": "1.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sherpa-onnx-node": "^1.13.8",
    "uqr": "^0.1.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.56.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.folio.htmlreader",
    "productName": "页间",
    "electronLanguages": [
      "en-US",
      "zh_CN",
      "zh-CN",
      "zh_TW",
      "zh-TW"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://helloxxy.com/works/folio/downloads/"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "samples",
        "to": "samples",
        "filter": [
          "**/*",
          "!**/.html-reader/**",
          "!**/.DS_Store"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir",
      "identity": "Li Ming wang (46AL7LQ9T8)",
      "icon": "assets/icon.icns",
      "notarize": true,
      "minimumSystemVersion": "12.0",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        {
          "from": "build/native/folio-speech",
          "to": "folio-speech"
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "白板语音对话时，页间用麦克风听你说话：用这台电脑的声音讲课时只在本机识别，用 ChatGPT 的声音讲课时会发给 ChatGPT。",
        "NSSpeechRecognitionUsageDescription": "白板语音对话时，页间把你说的话转成文字交给老师。"
      },
      "artifactName": "Folio-${version}-mac-${arch}.${ext}",
      "fileAssociations": [
        {
          "ext": [
            "html",
            "htm"
          ],
          "name": "HTML 文档",
          "role": "Editor",
          "rank": "Alternate"
        }
      ],
      "files": [
        "dist/**/*",
        "electron/**/*",
        "package.json",
        "!node_modules/sherpa-onnx-*{,/**/*}"
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "executableName": "Folio",
      "artifactName": "Folio-${version}-win-${arch}.${ext}",
      "files": [
        "dist/**/*",
        "electron/**/*",
        "package.json",
        "!node_modules/sherpa-onnx-{darwin,linux}-*{,/**/*}"
      ],
      "extraResources": [
        {
          "from": "native/hearing/silero_vad.onnx",
          "to": "silero_vad.onnx"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "shortcutName": "页间",
      "uninstallDisplayName": "页间 Folio",
      "include": "build/installer.nsh",
      "artifactName": "Folio-${version}-win-${arch}-setup.${ext}"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/sherpa-onnx-*/**"
    ],
    "npmRebuild": false,
    "dmg": {
      "title": "页间 Folio ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 88,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 75,
          "type": "file",
          "path": "docs/安装说明.txt"
        }
      ]
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true,
  "homepage": "https://github.com/XiangXiaoYuan5254/folio-html-reader",
  "repository": {
    "type": "git",
    "url": "https://github.com/XiangXiaoYuan5254/folio-html-reader.git"
  },
  "bugs": {
    "url": "https://github.com/XiangXiaoYuan5254/folio-html-reader/issues"
  }
}
