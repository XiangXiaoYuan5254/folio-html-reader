{
  "name": "folio-html-reader",
  "productName": "页间",
  "version": "0.6.1",
  "description": "本地 HTML / PDF 阅读、批注与项目管理",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "XiangXiaoYuan5254",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "npm run build && node tests/e2e.mjs && node tests/annotations.e2e.mjs && node tests/reading-interactions.e2e.mjs && node tests/zoom.e2e.mjs && node tests/pdf.e2e.mjs",
    "test:annotations": "npm run build && node tests/annotations.e2e.mjs",
    "pack": "npm run build && electron-builder --mac dir",
    "format": "prettier --write src electron scripts tests vite.config.ts",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --arm64 --publish never && node scripts/checksums.mjs",
    "test:reading": "npm run build && node tests/reading-interactions.e2e.mjs",
    "test:zoom": "npm run build && node tests/zoom.e2e.mjs",
    "test:pdf": "npm run build && node tests/pdf.e2e.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "codemirror": "^6.0.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.56.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.folio.htmlreader",
    "productName": "页间",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "samples",
        "to": "samples",
        "filter": [
          "**/*",
          "!**/.html-reader/**",
          "!**/.DS_Store"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dir",
      "identity": "-",
      "icon": "assets/icon.icns",
      "notarize": false,
      "minimumSystemVersion": "12.0"
    },
    "asar": true,
    "npmRebuild": false,
    "artifactName": "Folio-${version}-mac-${arch}.${ext}",
    "dmg": {
      "title": "页间 Folio ${version}",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 88,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 75,
          "type": "file",
          "path": "docs/安装说明.txt"
        }
      ]
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "private": true,
  "homepage": "https://github.com/XiangXiaoYuan5254/folio-html-reader",
  "repository": {
    "type": "git",
    "url": "https://github.com/XiangXiaoYuan5254/folio-html-reader.git"
  },
  "bugs": {
    "url": "https://github.com/XiangXiaoYuan5254/folio-html-reader/issues"
  }
}
