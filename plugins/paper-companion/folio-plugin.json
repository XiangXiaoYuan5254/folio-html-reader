{
  "folio": 1,
  "id": "paper-companion",
  "name": "论文伴读",
  "version": "1.0.0",
  "author": "页间",
  "description": "给正在读的论文写一篇伴读笔记：它在解决什么问题、方法的思路、关键公式和图怎么看、实验说明了什么、哪里值得怀疑。笔记是一篇 HTML，和论文一起记在文献库里，可以并排着读。",
  "engines": {
    "folio": ">=0.32.0"
  },
  "icon": "icon.svg",
  "files": ["prompt.md", "template.html", "icon.svg"],
  "run": {
    "prompt": "prompt.md",
    "template": "template.html",
    "tools": ["list_files", "read_document", "list_library", "update_library", "create_html"],
    "where": "project"
  },
  "triggers": [
    {
      "type": "button",
      "label": "给正在读的论文写伴读笔记"
    }
  ],
  "permissions": {
    "network": [],
    "write": ["{{output}}"]
  },
  "settings": [
    {
      "key": "output",
      "type": "folder",
      "label": "伴读笔记放在项目里的哪个文件夹",
      "hint": "",
      "default": "伴读笔记"
    },
    {
      "key": "reader",
      "type": "textarea",
      "label": "你的背景",
      "hint": "写给谁看：笔记会据此决定哪些要从头讲、哪些可以略过。",
      "default": "计算机专业的研究生，学过机器学习和深度学习的基础，不熟悉这篇论文的具体方向。"
    }
  ]
}
