<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Developer ID 签名 + 公证时使用的 entitlements。
  目前未启用：package.json 的 mac.entitlements 还没指向这里，
  现有的 ad-hoc 打包流程不受影响。

  启用方式见 docs/releasing.md 的「签名与公证」一节。
-->
<plist version="1.0">
  <dict>
    <!-- V8 需要 JIT。Electron 20+ 在 arm64 上缺这条会启动即崩溃。 -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Electron 运行时会申请可执行内存，hardened runtime 下需要放行。 -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- 白板语音对话要用麦克风；hardened runtime 下缺这条会被系统静默拒绝。 -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
